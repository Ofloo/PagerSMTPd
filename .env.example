# PagerSMPTd configuration — copy to .env and fill in. Never commit .env.

# Enig geaccepteerd RCPT-domein (verplicht). MX-records van dit domein moeten
# naar deze host wijzen.
PAGER_DOMAIN=pager.ofloo.io

# PagerMCP endpoint (HTTPS only)
PAGER_URL=https://pager.ofloo.io

# Attachment upload endpoint (HTTPS only)
SHARE_URL=https://share.h4ck.io

# Elke geldige <uuid>@PAGER_DOMAIN wordt geaccepteerd; PagerMCP beslist of de
# mailbox bestaat. Er is bewust geen enkele-vast-uuid-lock (PAGER_SESSION_ID
# wordt genegeerd).

# PROJECT-veld in het pager-payload
PAGER_PROJECT=smtp

# Kommagescheiden adressen/domeinen die via X-Pager-* (header of body-blok)
# urgentie mogen verhogen. Leeg = niemand; anderen worden geclamped naar warning.
# PAGER_TRUSTED_SENDERS=ops@example.net,@example.org

# Non-root runtime (optioneel). Leeg = ingebouwde user 'pager' (uid/gid 10000).
# Set naar je host uid/gid als je wilt dat de container als jouw user draait.
# PAGER_UID=
# PAGER_GID=

# Listen poort BINNEN de container (altijd >= 1024, non-root)
SMTP_PORT=8025

# Host poort mapping in docker-compose.yml
SMTP_HOST_BIND=127.0.0.1
SMTP_HOST_PORT=2525
# Publiek als MX: SMTP_HOST_BIND=0.0.0.0 en SMTP_HOST_PORT=25

# Limieten
MAX_MESSAGE_BYTES=60000          # headers+tekst -> 550 message too large
MAX_ATTACHMENT_BYTES=104857600   # 100 MB per attachment -> 550 attachment too large
MAX_ATTACHMENTS=10               # meer attachments -> 550
MAX_TOTAL_BYTES=105457600        # harde DATA-limiet (headers+tekst+attachments), ~100 MB
SHARE_TIMEOUT_SECONDS=60
PAGER_TIMEOUT_SECONDS=15
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO

# Alleen voor lokale tests: sta plain http:// toe voor PAGER_URL/SHARE_URL.
# NOOIT in productie zetten. (tests/run_tests.sh zet dit zelf.)
# PAGER_ALLOW_INSECURE=1
