# PagerSMPTd jail environment.
# Copy to /usr/local/etc/pagersmtpd.env and fill in — never commit the real file.
# Sourced by /usr/local/etc/rc.d/pagersmtpd (same variables as the Docker .env).

# Enig geaccepteerd RCPT-domein (verplicht). MX van dit domein -> deze FreeBSD host.
PAGER_DOMAIN=pager.ofloo.io

# PagerMCP endpoint (HTTPS only)
PAGER_URL=https://pager.ofloo.io

# Attachment upload endpoint (HTTPS only)
SHARE_URL=https://share.h4ck.io

# Optioneel: alleen dit ene uuid-adres accepteren (Bearer-check doet pager zelf)
# PAGER_SESSION_ID=

# Non-root runtime: FreeBSD rc vars, niet PAGER_UID/PAGER_GID:
#   sysrc pagersmtpd_uid=1000 pagersmtpd_gid=1000 pagersmtpd_user=pager
# (default user 'pager', uid/gid 10000)

SMTP_HOST=0.0.0.0
SMTP_PORT=8025

MAX_MESSAGE_BYTES=60000
MAX_ATTACHMENT_BYTES=104857600
SHARE_TIMEOUT_SECONDS=60
PAGER_TIMEOUT_SECONDS=15
RATE_LIMIT_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=60
LOG_LEVEL=INFO
